---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, SERIES, getStories, catTitle, catTag, NEWSLETTER_ACTION } from '../lib/sanity';
const stories = await getStories();
const featured = stories.find((s) => s.featured) ?? stories[0];
const rest = stories.filter((s) => s._id !== featured?._id);
const hot = rest.slice(0, 4);
const latest = rest.slice(4, 12);
---
<Base title="The Curious Pitch">
  <div class="hero">
    <div class="pitch"></div>
    <div class="wrap">
      <h1>Football has a story beyond the score.</h1>
      <p>Investigations, arguments, money and forgotten history from the game you think you know.</p>
      <div class="chips">
        {CATEGORIES.map((c) => <a class="chip" href={`/category/${c.slug}`}>{c.chip}</a>)}
      </div>
    </div>
  </div>

  {featured ? (
    <section><div class="wrap">
      <a class="feature" href={`/story/${featured.slug}`}>
        <small>{featured.series ?? catTitle(featured.category)}</small>
        <h3>{featured.title}</h3>
        <p>{featured.excerpt}</p>
        <span>Read the story</span>
      </a>
    </div></section>
  ) : (
    <section><div class="wrap"><p class="empty">No stories yet. Open /studio and publish your first one.</p></div></section>
  )}

  {hot.length > 0 && (
    <section style="padding-top:0"><div class="wrap hot">
      <h2>Hot right now</h2>
      {hot.map((s) => <a href={`/story/${s.slug}`}><b>{catTag(s.category)}</b><span>{s.title}</span></a>)}
    </div></section>
  )}

  {latest.length > 0 && (
    <section style="padding-top:0"><div class="wrap">
      <h2>Latest stories</h2>
      <div class="grid">{latest.map((s) => <PostCard story={s} />)}</div>
    </div></section>
  )}

  <section style="padding-top:0"><div class="wrap cats">
    <h2>Browse by topic</h2>
    {CATEGORIES.map((c) => <a href={`/category/${c.slug}`}><strong>{c.title}</strong><span>{c.blurb}</span></a>)}
  </div></section>

  <section style="padding-top:0">
    <div class="wrap"><h2>Our series</h2></div>
    <div class="wrap"><div class="series">
      {SERIES.map((s) => <div><h3>{s.title}</h3><p>{s.text}</p></div>)}
    </div></div>
  </section>

  <section style="padding-top:0" id="newsletter"><div class="wrap"><div class="news">
    <h2>One good question, every week</h2>
    <p>Get our best story in your inbox. No scores, no noise.</p>
    <form class="row" id="nform" method="post" action={NEWSLETTER_ACTION || undefined}>
      <input type="email" name="email" placeholder="Your email" aria-label="Email address" required />
      <button class="sub" type="submit">Subscribe</button>
    </form>
    <div id="nmsg" role="status"></div>
  </div></div></section>
</Base>

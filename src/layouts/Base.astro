---
import '../styles/global.css';
import { CATEGORIES } from '../lib/sanity';
const {
  title,
  description = 'Football stories beyond the score. Investigations, arguments, money and forgotten history.',
  image,
  article = false,
} = Astro.props;
const full = title === 'The Curious Pitch' ? title : `${title} | The Curious Pitch`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0A0C0B" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  {image && <meta property="og:image" content={image} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Source+Serif+4:wght@400;600&display=swap" rel="stylesheet" />
</head>
<body>
  {article && <div id="prog"></div>}
  <header>
    <div class="wrap bar">
      <a class="logo" href="/"><span class="mark"></span>The Curious Pitch</a>
      <div class="right">
        <a class="sub" href="/#newsletter">Subscribe</a>
        <button class="burger" id="open" type="button" aria-label="Open menu"><i></i><i></i></button>
      </div>
    </div>
  </header>
  <nav class="menu" id="menu" aria-label="Main menu">
    <button class="x" id="close" type="button" aria-label="Close menu">×</button>
    <a href="/">Home</a>
    {CATEGORIES.map((c) => <a href={`/category/${c.slug}`}>{c.title}</a>)}
  </nav>
  <main><slot /></main>
  <footer>
    <div class="wrap">
      <a class="logo" href="/"><span class="mark"></span>The Curious Pitch</a>
      <div class="links">
        <a href="/about">About</a><a href="/contact">Contact</a><a href="/privacy">Privacy policy</a><a href="/editorial-policy">Editorial policy</a>
      </div>
      <div>Question everything. Discover more.</div>
    </div>
  </footer>
  <script>
    const menu = document.getElementById('menu');
    document.getElementById('open')?.addEventListener('click', () => menu?.classList.add('open'));
    document.getElementById('close')?.addEventListener('click', () => menu?.classList.remove('open'));
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.remove('open')));

    const prog = document.getElementById('prog');
    if (prog) {
      const upd = () => {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        prog.style.width = (h > 0 ? Math.min(100, (window.scrollY / h) * 100) : 0) + '%';
      };
      window.addEventListener('scroll', upd, { passive: true });
      upd();
    }

    const nform = document.getElementById('nform');
    if (nform && !nform.getAttribute('action')) {
      nform.addEventListener('submit', (e) => {
        e.preventDefault();
        document.getElementById('nmsg').textContent = 'Signups open soon. Check back shortly.';
      });
    }

    const copy = document.getElementById('copy');
    copy?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(location.href); copy.textContent = 'Link copied'; }
      catch { copy.textContent = 'Copy from the address bar'; }
    });
    const wa = document.getElementById('wa');
    if (wa) wa.href = 'https://wa.me/?text=' + encodeURIComponent(document.title + ' ' + location.href);
  </script>
</body>
</html>

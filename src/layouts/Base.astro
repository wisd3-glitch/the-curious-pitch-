---
import { CATEGORIES } from "../lib/sanity";
const { title = "The Curious Pitch", description = "Football's big questions, asked properly." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <a class="logo" href="/">The Curious <b>Pitch</b></a>
    <nav id="nav">
      {Object.entries(CATEGORIES).map(([k, v]) => <a href={`/category/${k}`}>{v}</a>)}
    </nav>
    <button id="menu" aria-label="Menu" aria-expanded="false">Menu</button>
  </header>
  <main><slot /></main>
  <footer>
    <p class="logo">The Curious <b>Pitch</b></p>
    <p>Football's big questions, asked properly.</p>
    <div class="links">
      {Object.entries(CATEGORIES).map(([k, v]) => <a href={`/category/${k}`}>{v}</a>)}
    </div>
  </footer>
  <script>
    const b = document.getElementById("menu"), n = document.getElementById("nav");
    b?.addEventListener("click", () => {
      const open = n?.classList.toggle("open");
      b.setAttribute("aria-expanded", String(!!open));
    });
  </script>
</body>
</html>

<style is:global>
  :root { --bg:#0A0C0B; --card:#151917; --lime:#C8FF3D; --orange:#FF5A1F; --text:#F2F4EF; --muted:#8A918C; }
  * { box-sizing: border-box; margin: 0; }
  body { background: var(--bg); color: var(--text); font: 400 17px/1.65 Inter, system-ui, sans-serif; }
  h1, h2, h3, .logo { font-family: "Space Grotesk", system-ui, sans-serif; letter-spacing: -0.02em; line-height: 1.1; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--lime); outline-offset: 3px; }
  main, .top, footer { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  .top { display: flex; align-items: center; justify-content: space-between; height: 64px; position: sticky; top: 0; background: var(--bg); z-index: 10; max-width: none; padding: 0 max(20px, calc((100% - 1060px) / 2)); border-bottom: 1px solid #222823; }
  .logo { font-size: 1.25rem; font-weight: 700; }
  .logo b { color: var(--lime); }
  #nav { display: flex; gap: 20px; font-size: 0.9rem; color: var(--muted); }
  #nav a:hover { color: var(--lime); }
  #menu { display: none; background: var(--lime); color: #000; border: 0; padding: 8px 14px; border-radius: 6px; font-weight: 500; }
  @media (max-width: 800px) {
    #menu { display: block; }
    #nav { display: none; position: fixed; inset: 64px 0 0; background: var(--bg); flex-direction: column; padding: 28px 20px; font-size: 1.4rem; gap: 22px; color: var(--text); }
    #nav.open { display: flex; }
  }
  .tag { color: var(--orange); font-size: 0.85rem; font-weight: 500; }
  .meta { color: var(--muted); font-size: 0.85rem; }
  .hero { padding: 64px 0 40px; }
  .hero h1 { font-size: clamp(2.4rem, 8vw, 5rem); max-width: 14ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .chips a { border: 1px solid #2c332e; padding: 7px 14px; border-radius: 99px; font-size: 0.9rem; }
  .chips a:hover { border-color: var(--lime); color: var(--lime); }
  .featured { display: block; background: var(--lime); color: #0A0C0B; border-radius: 14px; padding: 32px; margin: 24px 0 48px; }
  .featured h2 { font-size: clamp(1.8rem, 5vw, 3rem); margin: 10px 0; }
  .featured .tag, .featured .meta { color: #26300a; }
  h2.sec { font-size: 1.6rem; margin: 48px 0 20px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 22px; }
  .card { background: var(--card); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; }
  .card:hover h3 { color: var(--lime); }
  .card .pic { aspect-ratio: 16/9; background: linear-gradient(135deg, #1d2a14, #0f1511); }
  .card .pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card .txt { padding: 18px; display: grid; gap: 8px; }
  .card h3 { font-size: 1.2rem; }
  .card p { color: var(--muted); font-size: 0.95rem; }
  .empty { color: var(--muted); padding: 40px 0; }
  article { max-width: 720px; margin: 0 auto; padding: 56px 0 40px; }
  article h1 { font-size: clamp(2rem, 6vw, 3.2rem); margin: 12px 0 16px; }
  article .cover { width: 100%; border-radius: 12px; margin: 28px 0; }
  .prose { font-size: 1.1rem; }
  .prose p { margin: 0 0 1.2em; }
  .prose h2, .prose h3 { margin: 1.8em 0 0.6em; }
  .prose img { width: 100%; border-radius: 10px; }
  .prose blockquote { border-left: 4px solid var(--lime); padding-left: 18px; font: 500 1.4rem/1.35 "Space Grotesk", sans-serif; margin: 1.6em 0; }
  .prose a { color: var(--lime); text-decoration: underline; }
  .verdict { background: var(--card); border: 1px solid var(--lime); border-radius: 12px; padding: 24px; margin: 40px 0; }
  .verdict h3 { color: var(--lime); margin-bottom: 8px; }
  .progress { position: fixed; top: 0; left: 0; height: 3px; width: 0; background: var(--lime); z-index: 20; }
  footer { border-top: 1px solid #222823; margin-top: 72px; padding-top: 32px; padding-bottom: 48px; color: var(--muted); display: grid; gap: 12px; max-width: none; padding-left: max(20px, calc((100% - 1060px) / 2)); padding-right: max(20px, calc((100% - 1060px) / 2)); }
  footer .links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 0.9rem; }
  footer .links a:hover { color: var(--lime); }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
</style>
